# Copy this file to .env and adjust local paths/secrets as needed.
OPERATION_MODE=OFFLINE
ARC_AGI3_ENVIRONMENTS_DIR=/path/to/rlm/environment_files
ARC_AGI3_FRAME_OBSERVATION_MODE=initial_full_then_diff
ARC_AGI3_FULL_FRAME_INTERVAL=8
ARC_AGI3_PATCH_RADIUS=4
ARC_AGI3_MAX_DIFF_EXAMPLES=32

# Optional online/evaluation credentials.
ARC_API_KEY=
WANDB_API_KEY=
